# ==============================================================================
# FoxxNuts Backend Server (FastAPI & Celery) - Environment Variables
# ==============================================================================

# Vector Database (Pinecone) & Hybrid Search
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=your-pinecone-index-name

# Embedding & Reranker Providers
COHERE_API_KEY=your-cohere-api-key
COHERE_MODEL=embed-english-v3.0
JINA_API_KEY=your-jina-api-key

# LLM Providers (Configure at least one for workspace generation)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Web Search Tool (Tavily Search Engine)
TAVILY_API_KEY=your-tavily-search-api-key

# Cloudflare R2 / S3-Compatible Object Storage
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Supabase Database & Auth (Service Role)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# FastAPI Backend Security
FASTAPI_SECRET_KEY=your-secure-fastapi-backend-secret-key

# Redis Broker & Cache (Standard URI for Celery & redis-py)
REDIS_URL=redis://localhost:6379/0

# Ingestion Batching & Performance Tuning
BATCH_SIZE=100
TIME_SLEEP=4
